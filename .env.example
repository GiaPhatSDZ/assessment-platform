# Public site configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Required for production persistence and auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only

# AI Provider Configuration (Optional - app gracefully functions without AI)
# Allowed providers: mock | openai | gemini
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# Analytics Configuration (Optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Admin Authorization (Server-only, comma-separated emails)
ADMIN_EMAILS=admin@example.com
