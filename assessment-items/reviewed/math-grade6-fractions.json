      "nodeIds": ["NODE-MATH-6-FRAC-03", "NODE-MATH-6-FRAC-02"],
      "type": "MULTIPLE_CHOICE",
      "cognitiveDemand": "APPLY",
      "prompt": "[Kiểm Tra Lại] Tính kết quả của phép tính: \\frac{1}{6} + \\frac{3}{10}",
      "options": [
        { "id": "A", "text": "\\frac{7}{15}" },
        { "id": "B", "text": "\\frac{4}{16}" },
        { "id": "C", "text": "\\frac{1}{4}" },
        { "id": "D", "text": "\\frac{14}{30}" }
      ],
      "correctAnswer": "A",
      "rationale": "BCNN(6, 10) = 30. Quy đồng: 1/6 = 5/30; 3/10 = 9/30. Tổng: 5/30 + 9/30 = 14/30 = 7/15 (rút gọn tối giản).",
      "distractorRationales": {
        "B": "Cộng tử với tử, mẫu với mẫu: (1+3)/(6+10) = 4/16.",
        "C": "Rút gọn 4/16 = 1/4 từ ngộ nhận cộng tử và mẫu.",
        "D": "Tính ra 14/30 nhưng chưa rút gọn về phân số tối giản 7/15."
      },
      "misconceptionTags": ["ADD_NUM_AND_DENOM_DIRECTLY", "UNSIMPLIFIED_RESULT"],
      "itemStatus": "REVIEWED",
      "isReTest": true
    },
